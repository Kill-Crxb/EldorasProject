// Editor-only. Three of these scan the scene with FindObjectsOfType every frame, and
// none of them belong in a player build.
#if UNITY_EDITOR
using UnityEngine;

public class DestroyLogger : MonoBehaviour
{
    private void OnDestroy()
    {
        Debug.LogError($"[DestroyLogger] {gameObject.name} was destroyed!");
    }
}

#endif
