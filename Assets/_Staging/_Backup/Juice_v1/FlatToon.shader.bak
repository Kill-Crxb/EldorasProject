// Flat / cel character shader for Unity 6 / URP 17. Also compiles on URP 12+.
//
// The lighting equation lives in CrabToonLighting.hlsl and the outline maths in
// CrabToonOutline.hlsl - both shared with Crab/FlatToonTriplanar so characters and
// environment cannot drift apart. Edit those to change behaviour; this file is passes.
//
// Passes: ForwardLit, Outline (SRPDefaultUnlit), ShadowCaster, DepthOnly, DepthNormals.
//
// Several ideas adapted from ColinLeung-NiloCat's UnityURPToonLitShaderExample (MIT):
// the separated lighting equation, constant-term ambient, light clamping, shadow test
// position offset, and the clip-space Z offset. https://github.com/ColinLeung-NiloCat/UnityURPToonLitShaderExample

Shader "Crab/FlatToon"
{
    Properties
    {
        [HideInInspector] _Role ("Role", Float) = 0

        [MainTexture] _BaseMap ("Base Map", 2D) = "white" {}
        [MainColor]   _BaseColor ("Base Color", Color) = (1,1,1,1)
        [Enum(UnityEngine.Rendering.CullMode)] _Cull ("Cull", Float) = 2
        [Toggle(_ALPHATEST_ON)] _AlphaClip ("Alpha Clip", Float) = 0
        _Cutoff ("Alpha Cutoff", Range(0,1)) = 0.5
        _ZOffset ("Depth Offset (view units)", Float) = 0
        _ObjectID ("Object ID (for edge lines)", Range(0,1)) = 0

        [Header(Shading)][Space(4)]
        _ShadeColor ("Shade Tint (multiply)", Color) = (0.62, 0.62, 0.68, 1)
        [Toggle(_USE_RAMP)] _UseRamp ("Use Shade Ramp", Float) = 0
        _ShadeRamp ("Shade Ramp (R)", 2D) = "white" {}
        _ShadeThreshold ("Terminator Position", Range(-1,1)) = 0.0
        _ShadeSoftness ("Terminator Softness", Range(0.0, 0.5)) = 0.015
        _Bands ("Tone Count (1 = two-tone)", Range(1, 6)) = 1
        _LightColorInfluence ("Light Color Influence", Range(0,1)) = 0.0
        _ShadowStrength ("Cast Shadow Strength", Range(0,1)) = 1.0
        _AdditionalLightScale ("Additional Light Scale", Range(0,1)) = 0.25

        [Header(Ambient)][Space(4)]
        _IndirectMinColor ("Indirect Floor Color", Color) = (0.05, 0.05, 0.07, 1)
        _IndirectStrength ("Ambient Hue Pickup", Range(0,1)) = 0.3

        [Header(Face)][Space(4)]
        [Toggle] _IsFace ("Is Face", Float) = 0
        _FaceShadowLift ("Face Shadow Lift", Range(0,1)) = 0.5
        _ShadowPosOffset ("Shadow Test Offset", Range(0,1)) = 0.0

        [Header(Base SDF)][Space(4)]
        [Toggle(_BASE_SDF)] _UseBaseSDF ("Enable Base SDF", Float) = 0
        _BaseSDF ("Base SDF (R)", 2D) = "white" {}
        _BaseSDFCoverage ("Shadow Coverage", Range(0,1)) = 0.5
        _BaseSDFSoftness ("Edge Softness", Range(0.0, 0.5)) = 0.01
        _BaseSDFFill ("Base Fill (adds light)", Range(0,1)) = 0.5
        _BaseSDFDepth ("Shadow Depth (holds dark)", Range(0,1)) = 0.5
        _BaseSDFHighlightCoverage ("Highlight Coverage", Range(0,1)) = 0.9
        _BaseSDFHighlight ("Highlight Strength", Range(0,1)) = 0.0
        _BaseSDFHighlightColor ("Highlight Color", Color) = (1,1,1,1)

        [Header(Base Light)][Space(4)]
        [Toggle(_BASE_LIGHT)] _UseBaseLight ("Enable Base Light", Float) = 0
        _BaseLightDir ("Base Light Direction", Vector) = (0, 1, 0.35, 0)
        _BaseLightStrength ("Base Light Strength", Range(0,1)) = 0.6
        _BaseLightThreshold ("Base Terminator Position", Range(-1,1)) = 0.0
        _BaseLightSoftness ("Base Terminator Softness", Range(0.0, 0.5)) = 0.01

        [Header(Shadow Pattern)][Space(4)]
        [Toggle(_SHADOW_TEXTURE)] _UseShadowTex ("Enable Shadow Pattern", Float) = 0
        _ShadowTex ("Pattern (R)", 2D) = "white" {}
        [KeywordEnum(UV, Screen, Anchored)] _ShadowTexMode ("Pattern Space", Float) = 2
        _ShadowTexScale ("Pattern Tiling", Float) = 32
        _ShadowTexAmount ("Pattern Coverage", Range(0,1)) = 0.5
        _ShadowTexSoftness ("Pattern Softness", Range(0.0, 0.5)) = 0.05
        _ShadowTexBlend ("Pattern Blend", Range(0,1)) = 0.6

        [Header(Optional Toon Specular)][Space(4)]
        [Toggle(_TOON_SPECULAR)] _UseSpecular ("Enable Toon Specular", Float) = 0
        _SpecularColor ("Specular Color", Color) = (1,1,1,1)
        _SpecularSize ("Specular Size", Range(0.0, 1.0)) = 0.1
        _SpecularSoftness ("Specular Softness", Range(0.0, 0.5)) = 0.02

        [Header(Optional Hair Specular)][Space(4)]
        [Toggle(_HAIR_SPECULAR)] _UseHairSpecular ("Enable Hair Specular", Float) = 0
        _HairSpecColor ("Hair Spec Color", Color) = (1,1,1,1)
        _HairShiftMap ("Hair Shift Map (R)", 2D) = "gray" {}
        _HairShiftStrength ("Shift Map Strength", Range(0,2)) = 0.5
        _HairSpecShift ("Band Position", Range(-1,1)) = 0.0
        _HairSpecPower ("Band Tightness", Range(1,200)) = 40.0
        _HairSpecThreshold ("Band Threshold", Range(0,1)) = 0.5
        _HairSpecSoftness ("Band Softness", Range(0.0, 0.5)) = 0.02

        [Header(Optional Rim)][Space(4)]
        [Toggle(_TOON_RIM)] _UseRim ("Enable Rim", Float) = 0
        _RimColor ("Rim Color", Color) = (1,1,1,1)
        _RimSize ("Rim Size", Range(0.0, 1.0)) = 0.7
        _RimSoftness ("Rim Softness", Range(0.0, 0.5)) = 0.02
        _RimMaskShadow ("Rim Shadow Mask", Range(0,1)) = 1.0

        [Header(Optional Emission)][Space(4)]
        [Toggle(_EMISSION)] _UseEmission ("Enable Emission", Float) = 0
        [HDR] _EmissionColor ("Emission Color", Color) = (0,0,0,1)
        _EmissionMap ("Emission Map", 2D) = "white" {}

        [Header(Outline)][Space(4)]
        _OutlineColor ("Outline Color", Color) = (0,0,0,1)
        _OutlineWidth ("Outline Width (world units, 0 = off)", Range(0, 0.05)) = 0.006
        _OutlineSilhouetteBias ("Silhouette Bias (evenness)", Range(1, 16)) = 4.0
        _OutlineWidthMap ("Outline Width Mask (R)", 2D) = "white" {}
        [Toggle(_SMOOTHED_NORMALS)] _UseSmoothedNormals ("Extrude Along Baked Normals (UV3)", Float) = 0
        [Toggle(_OUTLINE_TINT)] _UseOutlineTint ("Tint Outline From Base Map", Float) = 0
        _OutlineTintStrength ("Outline Tint Strength", Range(0,1)) = 0.8
        _OutlineTintDarkness ("Outline Tint Darkness", Range(0,1)) = 0.35
        _OutlineZOffset ("Outline Depth Push", Float) = 0.0
        _OutlineZOffsetMask ("Outline Depth Push Mask (R)", 2D) = "white" {}
        _OutlineFadeNear ("Outline Fade Near", Float) = 40.0
        _OutlineFadeFar ("Outline Fade Far", Float) = 150.0
    }

    SubShader
    {
        // NOTE: if this project ever moves to the Deferred renderer, change ForwardLit's
        // tag to "UniversalForwardOnly" and DepthNormals' to "DepthNormalsOnly" - together,
        // not one or the other. Under Forward they are equivalent, so they stay as-is.
        Tags
        {
            "RenderPipeline" = "UniversalPipeline"
            "RenderType" = "Opaque"
            "Queue" = "Geometry"
            "UniversalMaterialType" = "Lit"
        }
        LOD 300

        HLSLINCLUDE
        #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

        CBUFFER_START(UnityPerMaterial)
            float4 _BaseMap_ST;
            float4 _ShadeRamp_ST;
            float4 _ShadowTex_ST;
            float4 _BaseSDF_ST;
            float4 _EmissionMap_ST;
            float4 _HairShiftMap_ST;
            float4 _OutlineWidthMap_ST;
            float4 _OutlineZOffsetMask_ST;
            half   _Role;
            half4  _BaseColor;
            half   _Cull;
            half   _Cutoff;
            float  _ZOffset;
            half   _ObjectID;
            half4  _ShadeColor;
            half   _ShadeThreshold;
            half   _ShadeSoftness;
            half   _Bands;
            half   _LightColorInfluence;
            half   _ShadowStrength;
            half   _AdditionalLightScale;
            half4  _IndirectMinColor;
            half   _IndirectStrength;
            half   _IsFace;
            half   _FaceShadowLift;
            float  _ShadowPosOffset;
            half   _BaseSDFCoverage;
            half   _BaseSDFSoftness;
            half   _BaseSDFFill;
            half   _BaseSDFDepth;
            half   _BaseSDFHighlightCoverage;
            half   _BaseSDFHighlight;
            half4  _BaseSDFHighlightColor;
            float4 _BaseLightDir;
            half   _BaseLightStrength;
            half   _BaseLightThreshold;
            half   _BaseLightSoftness;
            float  _ShadowTexScale;
            half   _ShadowTexAmount;
            half   _ShadowTexSoftness;
            half   _ShadowTexBlend;
            half4  _SpecularColor;
            half   _SpecularSize;
            half   _SpecularSoftness;
            half4  _HairSpecColor;
            half   _HairShiftStrength;
            half   _HairSpecShift;
            half   _HairSpecPower;
            half   _HairSpecThreshold;
            half   _HairSpecSoftness;
            half4  _RimColor;
            half   _RimSize;
            half   _RimSoftness;
            half   _RimMaskShadow;
            half4  _EmissionColor;
            half4  _OutlineColor;
            half   _OutlineWidth;
            half   _OutlineSilhouetteBias;
            half   _OutlineTintStrength;
            half   _OutlineTintDarkness;
            float  _OutlineZOffset;
            float  _OutlineFadeNear;
            float  _OutlineFadeFar;
        CBUFFER_END
        ENDHLSL

        // ---------------------------------------------------------------- lit
        Pass
        {
            Name "ForwardLit"
            Tags { "LightMode" = "UniversalForward" }

            Cull [_Cull]
            ZWrite On

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ToonVertex
            #pragma fragment ToonFragment

            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma shader_feature_local_fragment _USE_RAMP
            #pragma shader_feature_local_fragment _BASE_SDF
            #pragma shader_feature_local_fragment _BASE_LIGHT
            #pragma shader_feature_local_fragment _SHADOW_TEXTURE
            #pragma shader_feature_local_fragment _SHADOWTEXMODE_UV _SHADOWTEXMODE_SCREEN _SHADOWTEXMODE_ANCHORED
            #pragma shader_feature_local_fragment _TOON_SPECULAR
            #pragma shader_feature_local_fragment _HAIR_SPECULAR
            #pragma shader_feature_local_fragment _TOON_RIM
            #pragma shader_feature_local_fragment _EMISSION

            #pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE _MAIN_LIGHT_SHADOWS_SCREEN
            #pragma multi_compile_fragment _ _SHADOWS_SOFT
            #pragma multi_compile _ _ADDITIONAL_LIGHTS
            #pragma multi_compile_fragment _ _ADDITIONAL_LIGHT_SHADOWS
            #pragma multi_compile_fragment _ _SCREEN_SPACE_OCCLUSION
            #pragma multi_compile _ _FORWARD_PLUS          // URP 17.0 (Unity 6.0)
            #pragma multi_compile _ _CLUSTER_LIGHT_LOOP  // URP 17.1+ (Unity 6.1 and up)
            #pragma multi_compile_fog
            #pragma multi_compile_instancing

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"

            TEXTURE2D(_BaseMap);       SAMPLER(sampler_BaseMap);
            TEXTURE2D(_ShadeRamp);     SAMPLER(sampler_ShadeRamp);
            TEXTURE2D(_ShadowTex);     SAMPLER(sampler_ShadowTex);
            TEXTURE2D(_BaseSDF);       SAMPLER(sampler_BaseSDF);
            TEXTURE2D(_HairShiftMap);  SAMPLER(sampler_HairShiftMap);
            TEXTURE2D(_EmissionMap);   SAMPLER(sampler_EmissionMap);

            #include "CrabToonLighting.hlsl"
            #include "CrabToonOutline.hlsl"

            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
                float4 tangentOS  : TANGENT;
                float2 uv         : TEXCOORD0;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv         : TEXCOORD0;
                float3 positionWS : TEXCOORD1;
                float3 normalWS   : TEXCOORD2;
                float3 tangentWS  : TEXCOORD3;
                float4 objectCS   : TEXCOORD4;
                float  fogCoord   : TEXCOORD5;
                UNITY_VERTEX_INPUT_INSTANCE_ID
                UNITY_VERTEX_OUTPUT_STEREO
            };

            half3 ToonSpecular(Light light, float3 normalWS, float3 viewDirWS)
            {
                float3 halfDir = SafeNormalize(light.direction + viewDirWS);
                half ndoth = saturate(dot(normalWS, halfDir));
                half threshold = 1.0h - _SpecularSize;
                half spec = smoothstep(threshold, threshold + _SpecularSoftness + 1e-4h, ndoth);
                return spec * _SpecularColor.rgb * light.shadowAttenuation * min(4.0h, light.distanceAttenuation);
            }

            // Kajiya-Kay: the highlight follows the hair's tangent rather than the surface
            // normal, which makes it a band across the strands instead of a dot. The shift
            // map breaks the band up so it does not read as a hoop.
            half3 HairSpecular(Light light, float3 normalWS, float3 tangentWS, float3 viewDirWS, float2 uv)
            {
                float2 shiftUV = TRANSFORM_TEX(uv, _HairShiftMap);
                half shift = SAMPLE_TEXTURE2D(_HairShiftMap, sampler_HairShiftMap, shiftUV).r - 0.5h;
                float3 shiftedTangent = normalize(tangentWS + normalWS * (shift * _HairShiftStrength + _HairSpecShift));

                float3 halfDir = SafeNormalize(light.direction + viewDirWS);
                half tdoth = dot(shiftedTangent, halfDir);
                half sinTH = sqrt(saturate(1.0h - tdoth * tdoth));
                half band = pow(sinTH, _HairSpecPower);

                half spec = smoothstep(_HairSpecThreshold, _HairSpecThreshold + _HairSpecSoftness + 1e-4h, band);
                return spec * _HairSpecColor.rgb * light.shadowAttenuation * min(4.0h, light.distanceAttenuation);
            }

            Varyings ToonVertex(Attributes IN)
            {
                Varyings OUT = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(IN);
                UNITY_TRANSFER_INSTANCE_ID(IN, OUT);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(OUT);

                VertexPositionInputs pos = GetVertexPositionInputs(IN.positionOS.xyz);
                VertexNormalInputs nrm = GetVertexNormalInputs(IN.normalOS, IN.tangentOS);

                OUT.positionCS = ApplyZOffset(pos.positionCS, _ZOffset);
                OUT.positionWS = pos.positionWS;
                OUT.normalWS = nrm.normalWS;
                OUT.tangentWS = nrm.tangentWS;
                OUT.uv = TRANSFORM_TEX(IN.uv, _BaseMap);
                OUT.fogCoord = ComputeFogFactor(pos.positionCS.z);

                // The object's own origin in clip space. Used to anchor a screen-space
                // pattern to the object so the character carries its tone with it instead
                // of sliding through a pattern pinned to the screen.
                float3 originVS = TransformWorldToView(TransformObjectToWorld(float3(0, 0, 0)));
                OUT.objectCS = mul(UNITY_MATRIX_P, float4(originVS, 1.0));

                return OUT;
            }

            half4 ToonFragment(Varyings IN, FRONT_FACE_TYPE cullFace : FRONT_FACE_SEMANTIC) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(IN);

                half4 albedo = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, IN.uv) * _BaseColor;

                #ifdef _ALPHATEST_ON
                    clip(albedo.a - _Cutoff);
                #endif

                // Double-sided geometry needs the normal flipped on back faces or the far
                // side of a hair card shades as though it faced away.
                half facing = IS_FRONT_VFACE(cullFace, 1.0h, -1.0h);
                float3 normalWS = normalize(IN.normalWS) * facing;
                float3 tangentWS = normalize(IN.tangentWS);
                float3 viewDirWS = GetWorldSpaceNormalizeViewDir(IN.positionWS);
                float2 screenUV = GetNormalizedScreenSpaceUV(IN.positionCS);

                half occlusion = 1.0h;

                #if defined(_SCREEN_SPACE_OCCLUSION)
                    AmbientOcclusionFactor ao = GetScreenSpaceAmbientOcclusion(screenUV);
                    occlusion = ao.directAmbientOcclusion;
                #endif

                // Main light shadows are sampled from an offset position, so the shadow map
                // does not resolve a nose or a fringe into blotches across the cheek.
                Light mainLight = GetMainLight();
                float4 shadowCoord = GetToonShadowCoord(IN.positionWS, mainLight.direction);

                #if defined(_MAIN_LIGHT_SHADOWS) || defined(_MAIN_LIGHT_SHADOWS_CASCADE) || defined(_MAIN_LIGHT_SHADOWS_SCREEN)
                    mainLight.shadowAttenuation = MainLightRealtimeShadow(shadowCoord);
                #endif

                InputData inputData = (InputData)0;
                inputData.positionWS = IN.positionWS;
                inputData.normalWS = normalWS;
                inputData.viewDirectionWS = viewDirWS;
                inputData.shadowCoord = shadowCoord;
                inputData.normalizedScreenSpaceUV = screenUV;

                half3 directRamp = ToonLightContribution(mainLight, normalWS, occlusion, false);
                half3 specular = half3(0, 0, 0);

                #ifdef _TOON_SPECULAR
                    specular += ToonSpecular(mainLight, normalWS, viewDirWS);
                #endif

                #ifdef _HAIR_SPECULAR
                    specular += HairSpecular(mainLight, normalWS, tangentWS, viewDirWS, IN.uv);
                #endif

                half4 shadowMask = half4(1, 1, 1, 1);
                uint lightCount = GetAdditionalLightsCount();

                LIGHT_LOOP_BEGIN(lightCount)
                    Light addLight = GetAdditionalLight(lightIndex, IN.positionWS, shadowMask);
                    directRamp += ToonLightContribution(addLight, normalWS, occlusion, true);
                    #ifdef _TOON_SPECULAR
                        specular += ToonSpecular(addLight, normalWS, viewDirWS);
                    #endif
                    #ifdef _HAIR_SPECULAR
                        specular += HairSpecular(addLight, normalWS, tangentWS, viewDirWS, IN.uv);
                    #endif
                LIGHT_LOOP_END

                // Authored lighting layer. The map is a distance field, not a painted
                // shadow, so Coverage slides the boundary through a nested set of regions
                // and every setting still yields a hard edge. Fill adds light; Depth holds
                // the dark areas dark even under a strong key light.
                half sdfHighlight = 0.0h;

                #ifdef _BASE_SDF
                    half sdf = SAMPLE_TEXTURE2D(_BaseSDF, sampler_BaseSDF, TRANSFORM_TEX(IN.uv, _BaseSDF)).r;
                    half sdfLit = smoothstep(_BaseSDFCoverage, _BaseSDFCoverage + _BaseSDFSoftness + 1e-4h, sdf);

                    directRamp += sdfLit * _BaseSDFFill;
                    directRamp *= lerp(1.0h, sdfLit, _BaseSDFDepth);

                    sdfHighlight = smoothstep(_BaseSDFHighlightCoverage, _BaseSDFHighlightCoverage + _BaseSDFSoftness + 1e-4h, sdf) * _BaseSDFHighlight;
                #endif

                // A fixed light that owes nothing to the scene, so a character never goes
                // flat in ambient-only lighting. Deliberately not affected by cast shadows.
                #ifdef _BASE_LIGHT
                    half baseNdotL = dot(normalWS, normalize(_BaseLightDir.xyz));
                    half baseEdge = smoothstep(_BaseLightThreshold, _BaseLightThreshold + _BaseLightSoftness + 1e-4h, baseNdotL);
                    directRamp += baseEdge * _BaseLightStrength;
                #endif

                // Halftone. The pattern texture supplies the THRESHOLD and the light level
                // is what gets compared against it, so dots grow in the dark and shrink
                // toward the light instead of being a fixed stamp over the shadow region.
                // It modulates the lighting rather than the colour, which is why it reads
                // as tone rather than as a decal.
                #ifdef _SHADOW_TEXTURE
                    #if defined(_SHADOWTEXMODE_UV)
                        float2 patternUV = TRANSFORM_TEX(IN.uv, _ShadowTex);
                    #elif defined(_SHADOWTEXMODE_ANCHORED)
                        float2 patternUV = (screenUV * 2.0 - 1.0) * IN.objectCS.w - IN.objectCS.xy;
                    #else
                        float2 patternUV = screenUV;
                    #endif

                    float aspect = _ScreenParams.y / max(_ScreenParams.x, 1.0);
                    patternUV *= _ShadowTexScale * float2(1.0, aspect);

                    half pattern = SAMPLE_TEXTURE2D(_ShadowTex, sampler_ShadowTex, patternUV).r;
                    directRamp = ApplyHalftone(directRamp, pattern);
                #endif

                half3 shadeTint = _ShadeColor.rgb;

                half3 color = CompositeToon(albedo.rgb, shadeTint, directRamp, ToonAmbient());
                color += specular;
                color += sdfHighlight * _BaseSDFHighlightColor.rgb;

                #ifdef _TOON_RIM
                    half fresnel = 1.0h - saturate(dot(normalWS, viewDirWS));
                    half rimEdge = 1.0h - _RimSize;
                    half rim = smoothstep(rimEdge, rimEdge + _RimSoftness + 1e-4h, fresnel);
                    // Blendable rather than a hard gate: at 0 the rim wraps the whole
                    // silhouette, at 1 it only survives where the surface is already lit.
                    half3 rimLight = lerp(half3(rim, rim, rim), rim * saturate(directRamp), _RimMaskShadow);
                    color += rimLight * _RimColor.rgb;
                #endif

                #ifdef _EMISSION
                    float2 emissionUV = TRANSFORM_TEX(IN.uv, _EmissionMap);
                    color += SAMPLE_TEXTURE2D(_EmissionMap, sampler_EmissionMap, emissionUV).rgb * _EmissionColor.rgb;
                #endif

                color = MixFog(color, IN.fogCoord);
                return half4(color, albedo.a);
            }
            ENDHLSL
        }

        // ------------------------------------------------------------ outline
        Pass
        {
            Name "Outline"
            Tags { "LightMode" = "SRPDefaultUnlit" }

            Cull Front
            ZWrite On
            ZTest LEqual

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex OutlineVertex
            #pragma fragment OutlineFragment

            #pragma shader_feature_local_vertex _SMOOTHED_NORMALS
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma shader_feature_local_fragment _OUTLINE_TINT
            #pragma multi_compile_fog
            #pragma multi_compile_instancing

            TEXTURE2D(_BaseMap);            SAMPLER(sampler_BaseMap);
            TEXTURE2D(_OutlineWidthMap);    SAMPLER(sampler_OutlineWidthMap);
            TEXTURE2D(_OutlineZOffsetMask); SAMPLER(sampler_OutlineZOffsetMask);

            #include "CrabToonOutline.hlsl"

            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
                float2 uv         : TEXCOORD0;
                float3 smoothNormalOS : TEXCOORD3;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv         : TEXCOORD0;
                float  fogCoord   : TEXCOORD1;
                UNITY_VERTEX_OUTPUT_STEREO
            };

            Varyings OutlineVertex(Attributes IN)
            {
                Varyings OUT = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(IN);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(OUT);

                float3 extrudeOS = IN.normalOS;

                // A mesh with no UV3 hands us (0,0,0) here, and normalize() of that is NaN,
                // which stretches the hull across the whole screen. Fall back to the mesh
                // normal so a missing bake degrades to a torn outline, not a disaster.
                #ifdef _SMOOTHED_NORMALS
                    float3 smoothOS = IN.smoothNormalOS;
                    extrudeOS = dot(smoothOS, smoothOS) > 1e-6 ? normalize(smoothOS) : IN.normalOS;
                #endif

                float3 positionWS = TransformObjectToWorld(IN.positionOS.xyz);
                float3 normalWS = TransformObjectToWorldNormal(extrudeOS);
                float3 positionVS = TransformWorldToView(positionWS);
                float3 normalVS = TransformWorldToViewDir(normalWS, true);

                float2 maskUV = TRANSFORM_TEX(IN.uv, _OutlineWidthMap);
                half mask = SAMPLE_TEXTURE2D_LOD(_OutlineWidthMap, sampler_OutlineWidthMap, maskUV, 0).r;

                float fade = GetOutlineDistanceFade(positionWS);
                float2 offset = GetOutlineOffset(normalVS, _OutlineSilhouetteBias) * mask * fade;

                positionVS.xy += offset * _OutlineWidth;
                float4 positionCS = mul(UNITY_MATRIX_P, float4(positionVS, 1.0));

                // Sink the hull backwards in depth only. Lets the face and other features
                // sit in front of their own outline without moving any geometry.
                float2 zMaskUV = TRANSFORM_TEX(IN.uv, _OutlineZOffsetMask);
                half zMask = SAMPLE_TEXTURE2D_LOD(_OutlineZOffsetMask, sampler_OutlineZOffsetMask, zMaskUV, 0).r;
                positionCS = ApplyZOffset(positionCS, _OutlineZOffset * zMask);

                OUT.positionCS = positionCS;
                OUT.uv = TRANSFORM_TEX(IN.uv, _BaseMap);
                OUT.fogCoord = ComputeFogFactor(positionCS.z);
                return OUT;
            }

            half4 OutlineFragment(Varyings IN) : SV_Target
            {
                half4 albedo = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, IN.uv) * _BaseColor;

                #ifdef _ALPHATEST_ON
                    clip(albedo.a - _Cutoff);
                #endif

                half3 outlineColor = _OutlineColor.rgb;

                // A line tinted toward a dark version of the surface reads as ink over
                // paint. Flat black over skin reads as dirt.
                #ifdef _OUTLINE_TINT
                    outlineColor = lerp(_OutlineColor.rgb, albedo.rgb * _OutlineTintDarkness, _OutlineTintStrength);
                #endif

                return half4(MixFog(outlineColor, IN.fogCoord), 1.0);
            }
            ENDHLSL
        }

        // ------------------------------------------------------- shadow caster
        Pass
        {
            Name "ShadowCaster"
            Tags { "LightMode" = "ShadowCaster" }

            ZWrite On
            ZTest LEqual
            ColorMask 0
            Cull [_Cull]

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex ShadowVertex
            #pragma fragment ShadowFragment
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma multi_compile_instancing
            #pragma multi_compile_vertex _ _CASTING_PUNCTUAL_LIGHT_SHADOW

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"

            TEXTURE2D(_BaseMap); SAMPLER(sampler_BaseMap);

            float3 _LightDirection;
            float3 _LightPosition;

            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
                float2 uv         : TEXCOORD0;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv         : TEXCOORD0;
                UNITY_VERTEX_OUTPUT_STEREO
            };

            Varyings ShadowVertex(Attributes IN)
            {
                Varyings OUT = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(IN);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(OUT);

                float3 positionWS = TransformObjectToWorld(IN.positionOS.xyz);
                float3 normalWS = TransformObjectToWorldNormal(IN.normalOS);

                #if defined(_CASTING_PUNCTUAL_LIGHT_SHADOW)
                    float3 lightDirWS = normalize(_LightPosition - positionWS);
                #else
                    float3 lightDirWS = _LightDirection;
                #endif

                float4 positionCS = TransformWorldToHClip(ApplyShadowBias(positionWS, normalWS, lightDirWS));

                #if UNITY_REVERSED_Z
                    positionCS.z = min(positionCS.z, UNITY_NEAR_CLIP_VALUE);
                #else
                    positionCS.z = max(positionCS.z, UNITY_NEAR_CLIP_VALUE);
                #endif

                OUT.positionCS = positionCS;
                OUT.uv = TRANSFORM_TEX(IN.uv, _BaseMap);
                return OUT;
            }

            half4 ShadowFragment(Varyings IN) : SV_Target
            {
                #ifdef _ALPHATEST_ON
                    half alpha = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, IN.uv).a * _BaseColor.a;
                    clip(alpha - _Cutoff);
                #endif

                return 0;
            }
            ENDHLSL
        }

        // ---------------------------------------------------------- depth only
        Pass
        {
            Name "DepthOnly"
            Tags { "LightMode" = "DepthOnly" }

            ZWrite On
            ColorMask R
            Cull [_Cull]

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex DepthVertex
            #pragma fragment DepthFragment
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma multi_compile_instancing

            TEXTURE2D(_BaseMap); SAMPLER(sampler_BaseMap);

            #include "CrabToonOutline.hlsl"

            struct Attributes
            {
                float4 positionOS : POSITION;
                float2 uv         : TEXCOORD0;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float2 uv         : TEXCOORD0;
                UNITY_VERTEX_OUTPUT_STEREO
            };

            Varyings DepthVertex(Attributes IN)
            {
                Varyings OUT = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(IN);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(OUT);
                OUT.positionCS = ApplyZOffset(TransformObjectToHClip(IN.positionOS.xyz), _ZOffset);
                OUT.uv = TRANSFORM_TEX(IN.uv, _BaseMap);
                return OUT;
            }

            half4 DepthFragment(Varyings IN) : SV_Target
            {
                #ifdef _ALPHATEST_ON
                    half alpha = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, IN.uv).a * _BaseColor.a;
                    clip(alpha - _Cutoff);
                #endif

                return 0;
            }
            ENDHLSL
        }

        // ------------------------------------------------------- depth normals
        Pass
        {
            Name "DepthNormals"
            Tags { "LightMode" = "DepthNormals" }

            ZWrite On
            Cull [_Cull]

            HLSLPROGRAM
            #pragma target 3.5
            #pragma vertex DepthNormalsVertex
            #pragma fragment DepthNormalsFragment
            #pragma shader_feature_local_fragment _ALPHATEST_ON
            #pragma multi_compile_instancing

            TEXTURE2D(_BaseMap); SAMPLER(sampler_BaseMap);

            #include "CrabToonOutline.hlsl"

            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
                float2 uv         : TEXCOORD0;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float3 normalWS   : TEXCOORD0;
                float2 uv         : TEXCOORD1;
                UNITY_VERTEX_OUTPUT_STEREO
            };

            Varyings DepthNormalsVertex(Attributes IN)
            {
                Varyings OUT = (Varyings)0;
                UNITY_SETUP_INSTANCE_ID(IN);
                UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(OUT);
                OUT.positionCS = ApplyZOffset(TransformObjectToHClip(IN.positionOS.xyz), _ZOffset);
                OUT.normalWS = TransformObjectToWorldNormal(IN.normalOS);
                OUT.uv = TRANSFORM_TEX(IN.uv, _BaseMap);
                return OUT;
            }

            half4 DepthNormalsFragment(Varyings IN) : SV_Target
            {
                #ifdef _ALPHATEST_ON
                    half alpha = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, IN.uv).a * _BaseColor.a;
                    clip(alpha - _Cutoff);
                #endif

                // Alpha of the normals buffer is otherwise unused, so the object ID
                // rides along in it. The outline pass compares IDs between neighbouring
                // pixels: any difference is an exact boundary between two things, with no
                // threshold to tune and no false lines on curved surfaces.
                return half4(normalize(IN.normalWS), _ObjectID);
            }
            ENDHLSL
        }
    }

    CustomEditor "FlatToonGUI"

    // No FallBack on purpose: a silent fallback to Lit hides compile errors behind a
    // plausible-looking PBR character, and serialises Lit's properties into every material.
}
