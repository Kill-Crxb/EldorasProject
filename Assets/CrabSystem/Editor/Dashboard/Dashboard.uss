/* Crab Dashboard. Neutral overlays so it reads in both editor themes. */

.crab-dashboard {
    flex-grow: 1;
}

.frame {
    flex-grow: 1;
    flex-direction: row;
}

/* Rail */
.rail {
    width: 170px;
    flex-shrink: 0;
    padding: 6px 4px;
    background-color: rgba(0, 0, 0, 0.12);
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.3);
}

.rail-group {
    margin: 10px 6px 4px 6px;
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.6;
}

.rail-tab {
    height: 26px;
    margin: 1px 2px;
    -unity-text-align: middle-left;
    padding-left: 10px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
}

.rail-tab:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.rail-tab.selected {
    background-color: rgba(80, 140, 220, 0.35);
    -unity-font-style: bold;
}

/* Body */
.body {
    flex-grow: 1;
    padding: 6px 8px;
}

.tab-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin: 2px 2px 6px 2px;
}

.tab-content {
    flex-grow: 1;
}

/* Columns: list | editor | checks */
.columns {
    flex-grow: 1;
    flex-direction: row;
}

.columns-main {
    flex-grow: 1;
    flex-direction: row;
}

.pane {
    margin: 2px;
    padding: 6px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.08);
}

.pane-list {
    width: 260px;
    flex-shrink: 0;
}

.pane-editor {
    flex-grow: 1;
    flex-basis: 0;
}

.pane-checks {
    width: 380px;
    flex-shrink: 0;
}

.narrow .columns-main {
    flex-direction: column;
}

.narrow .pane-checks {
    width: auto;
    height: 40%;
}

.pane-heading {
    -unity-font-style: bold;
    margin: 2px 2px 6px 2px;
}

.pane-note {
    white-space: normal;
    opacity: 0.7;
    margin: 2px 2px 8px 2px;
}

.pane-button {
    height: 24px;
    margin: 2px 0;
}

.list-entry {
    height: 22px;
    margin: 1px 0;
    -unity-text-align: middle-left;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.list-entry.selected {
    background-color: rgba(80, 140, 220, 0.3);
}

.imgui-host {
    flex-grow: 1;
}

/* Issue list */
.issue-list {
    flex-grow: 1;
}

.issue-search {
    width: auto;
    margin-bottom: 4px;
}

.issue-rows {
    flex-grow: 1;
}

.issue-empty {
    opacity: 0.6;
    margin: 6px;
}

.issue-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
}

.issue-badge {
    width: 58px;
    flex-shrink: 0;
    font-size: 10px;
    -unity-font-style: bold;
}

.issue-badge.error { color: rgb(230, 110, 110); }
.issue-badge.warning { color: rgb(230, 190, 110); }
.issue-badge.info { color: rgb(140, 170, 190); }

.issue-text {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Tools */
.command-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
}

.command-run {
    width: 50px;
    height: 20px;
}

.command-name {
    flex-grow: 1;
}

.command-owner {
    opacity: 0.5;
    font-size: 10px;
}

/* Log strip */
.log-strip {
    height: 20px;
    padding: 2px 8px;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0.18);
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
}
