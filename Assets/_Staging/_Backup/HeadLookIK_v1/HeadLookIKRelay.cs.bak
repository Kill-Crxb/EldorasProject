using UnityEngine;

// Auto-attached by HeadLookSystem. OnAnimatorIK is only delivered to a component sharing
// the Animator's GameObject, and the Animator sits under the model root rather than under
// the Brain, so the module cannot receive the callback itself.
[DisallowMultipleComponent]
public class HeadLookIKRelay : MonoBehaviour
{
    private HeadLookSystem system;
    private Animator animator;
    private int lastHandledFrame = -1;

    public void Bind(HeadLookSystem headLookSystem)
    {
        system = headLookSystem;
        animator = GetComponent<Animator>();
    }

    void OnAnimatorIK(int layerIndex)
    {
        if (system == null || animator == null) return;

        // Fires once per IK-enabled layer. The look target is layer-independent, so only the
        // first call each frame does the work.
        if (lastHandledFrame == Time.frameCount) return;
        lastHandledFrame = Time.frameCount;

        system.ApplyLookAt(animator);
    }
}
