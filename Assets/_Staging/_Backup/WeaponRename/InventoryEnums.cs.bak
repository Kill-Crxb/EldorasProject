// Shared enums for the inventory and combat systems.

/// <summary>
/// Item rarity levels affecting visual appearance and gameplay value
/// </summary>
public enum ItemRarity
{
    Common,
    Uncommon,
    Rare,
    Epic,
    Legendary
}

/// <summary>
/// Weapon categories for combat system integration
/// </summary>
public enum WeaponType
{
    // Manufactured weapons (Humanoids)
Knife,
Sword,
Greatsword,
Polearm,
Shiruken,
Spear,
Staff,
Shield,
Unarmed,
DualBlade,

    // Natural weapons (Animals)
    Claw,
    Teeth,
    Horn,
    Tail,
    Wing,
    Stinger,
    Tentacle
}

/// <summary>
/// Armor categories for defense calculations
/// </summary>
public enum ArmorType
{
    None,
    Light,
    Medium,
    Heavy,
    Cloth,
    Leather,
    Mail,
    Plate
}