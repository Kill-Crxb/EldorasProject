  m_Script: {fileID: 11500000, guid: 63f1401dcb445534faca4def0618a012, type: 3}
  m_Name: DefensiveCore
  m_EditorClassIdentifier: Assembly-CSharp::NinjaGame.Stats.StatSchema
  derived: 1
  entries:
  - id: atr.arm
    displayName: Armor
    shortName: arm
    description: Flat armour shield capacity, under the dice. Armour pieces and talents add it.
    defaultValue: 0
    minValue: -20
    maxValue: 20
  - id: atr.arm_dice
    displayName: Armor Dice
    shortName: armd
    description: Armour shield segments, one d4 each, rolled when they refill. Armour pieces and Stoneskin add them.
    defaultValue: 0
    minValue: 0
    maxValue: 10
  - id: atr.arm_def
    displayName: Armor Defense
    shortName: armdef
    description: Armour's bonus to Defense, the target number of the hit roll.
    defaultValue: 0
    minValue: 0
    maxValue: 10
  - id: equip.load
    displayName: Equip Load
    shortName: load
    description: Sum of worn armour's load. Each point is a step down the freedom track (Combat_Framework 6.4); conditioning subtracts.
    defaultValue: 0
    minValue: 0
    maxValue: 30
